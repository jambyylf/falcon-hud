history.json
window-state.json
parser-issues.log
falconhud/
usage-cache.json
limits-cache.json
falcon-hud-state.json

# ═══════════ Кэш және лог ═══════════
.cache/
cache/
.tmp/
tmp/
*.tmp
*.log
logs/
npm-debug.log*
yarn-error.log*
.eslintcache

